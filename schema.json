{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keys.vlayer.xyz/schema.json",
  "title": "vlayer notary keys",
  "description": "List of signing keys used by vlayer notaries. See https://github.com/vlayer-xyz/notary-keys#readme.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "fingerprintAlgorithm", "keys"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "fingerprintAlgorithm": {
      "const": "sha256 over compressed SEC1 public key, lowercase hex"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/key" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "description": "RFC 3339 UTC timestamp with second precision and a literal Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "publicKeyPem", "curve", "validFrom", "validUntil", "meta"],
      "properties": {
        "fingerprint": {
          "type": "string",
          "description": "SHA-256 of the compressed SEC1 point, lowercase hex.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publicKeyPem": {
          "type": "string",
          "description": "Compressed-point SubjectPublicKeyInfo PEM, byte-identical to the notary's GET /info publicKey.",
          "pattern": "^-----BEGIN PUBLIC KEY-----\\n([A-Za-z0-9+/=]+\\n)+-----END PUBLIC KEY-----\\n$"
        },
        "curve": { "enum": ["secp256k1", "secp256r1"] },
        "validFrom": { "$ref": "#/$defs/timestamp" },
        "validUntil": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }]
        },
        "meta": {
          "type": "object",
          "description": "Informational fields only; verifiers must not base decisions on them.",
          "required": ["notaryUrls"],
          "properties": {
            "notaryUrls": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^https://[^/\\s]+$" }
            }
          }
        }
      }
    }
  }
}
